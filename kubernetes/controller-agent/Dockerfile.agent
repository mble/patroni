ARG BUILD_IMAGE=python:3.11-slim-bookworm@sha256:528257d48c1da0dcecc2e725d1ae34498d60c965f1241e39cd6a85a8859bdf84
ARG RUNTIME_IMAGE=postgres:18-bookworm@sha256:1c59e2c3c818eaa0f0628f695b36e7c9e362d6b219b36a54a32df645cbd7e1af

FROM ${BUILD_IMAGE} AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /src

COPY kubernetes/controller-agent/requirements-agent.lock /tmp/requirements.lock
RUN python -m pip install \
        --require-hashes \
        --no-compile \
        --no-deps \
        --target /opt/patroni \
        --requirement /tmp/requirements.lock

COPY LICENSE README.rst requirements.txt setup.py /src/
COPY patroni /src/patroni
RUN python -m pip install \
        --no-compile \
        --no-deps \
        --target /opt/patroni \
        /src \
    && rm -rf /opt/patroni/bin

FROM ${RUNTIME_IMAGE}

ARG RUNTIME_UID=999
ARG RUNTIME_GID=999

USER root
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install --no-install-recommends -y dumb-init python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/patroni \
    PYTHONUNBUFFERED=1
WORKDIR /home/postgres

COPY --from=build --chown=${RUNTIME_UID}:${RUNTIME_GID} /opt/patroni /opt/patroni

USER ${RUNTIME_UID}:${RUNTIME_GID}
EXPOSE 5432
ENTRYPOINT ["/usr/bin/dumb-init", "--single-child", "--", "/usr/bin/python3", "-m", "patroni.agent"]
CMD ["/etc/patroni/agent.yml"]
